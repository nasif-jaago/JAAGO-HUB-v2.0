{
  "name": "jaago-worker",
  "version": "2.0.0",
  "private": true,
  "description": "JAAGO ERP Background Worker — BullMQ consumers and cron jobs (Direct Internal Modules)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test:unit": "vitest run --reporter=verbose",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.5",
    "bullmq": "^5.56.0",
    "ioredis": "^5.6.1",
    "pino": "^9.7.0",
    "postgres": "^3.4.5",
    "drizzle-orm": "^0.39.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "ioredis-mock": "^8.9.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
