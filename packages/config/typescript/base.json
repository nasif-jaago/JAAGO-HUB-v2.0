{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@jaago/testing": ["../../testing/src/index.ts", "../../testing/src"],
      "@jaago/testing/*": ["../../testing/src/*"],
      "@jaago/validation": ["../../validation/src/index.ts", "../../validation/src"],
      "@jaago/validation/*": ["../../validation/src/*"],
      "@jaago/shared-types": ["../../shared-types/src/index.ts", "../../shared-types/src"],
      "@jaago/shared-types/*": ["../../shared-types/src/*"],
      "@jaago/database": ["../../database/src/index.ts", "../../database/src"],
      "@jaago/database/*": ["../../database/src/*"],
      "@jaago/auth": ["../../auth/src/index.ts", "../../auth/src"],
      "@jaago/auth/*": ["../../auth/src/*"],
      "@jaago/cache": ["../../cache/src/index.ts", "../../cache/src"],
      "@jaago/cache/*": ["../../cache/src/*"],
      "@jaago/logger": ["../../logger/src/index.ts", "../../logger/src"],
      "@jaago/logger/*": ["../../logger/src/*"],
      "@jaago/observability": ["../../observability/src/index.ts", "../../observability/src"],
      "@jaago/observability/*": ["../../observability/src/*"],
      "@jaago/security": ["../../security/src/index.ts", "../../security/src"],
      "@jaago/security/*": ["../../security/src/*"],
      "@jaago/queue": ["../../queue/src/index.ts", "../../queue/src"],
      "@jaago/queue/*": ["../../queue/src/*"],
      "@jaago/events": ["../../events/src/index.ts", "../../events/src"],
      "@jaago/events/*": ["../../events/src/*"],
      "@jaago/integrations": ["../../integrations/src/index.ts", "../../integrations/src"],
      "@jaago/integrations/*": ["../../integrations/src/*"],
      "@jaago/mcp": ["../../mcp/src/index.ts", "../../mcp/src"],
      "@jaago/mcp/*": ["../../mcp/src/*"],
      "@jaago/api-client": ["../../api-client/src/index.ts", "../../api-client/src"],
      "@jaago/api-client/*": ["../../api-client/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
