{
  "name": "@jaago/logger",
  "version": "0.0.1",
  "private": true,
  "description": "Non-blocking Pino logger with structural redaction, ring buffer, and background flusher for JAAGO ERP",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test:unit": "vitest run --reporter=verbose",
    "test:unit:watch": "vitest watch",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@jaago/config-typescript": "workspace:*",
    "@types/node": "^22.15.32",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
