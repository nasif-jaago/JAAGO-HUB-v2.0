{
  "name": "@jaago/api",
  "version": "0.0.1",
  "private": true,
  "description": "JAAGO ERP Backend — NestJS on Fastify",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test:unit": "jest --testPathPattern=.spec.ts",
    "test:integration": "jest --testPathPattern=.integration.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@jaago/auth": "workspace:*",
    "@jaago/cache": "workspace:*",
    "@jaago/database": "workspace:*",
    "@jaago/events": "workspace:*",
    "@jaago/logger": "workspace:*",
    "@jaago/observability": "workspace:*",
    "@jaago/queue": "workspace:*",
    "@jaago/security": "workspace:*",
    "@jaago/shared-types": "workspace:*",
    "@jaago/validation": "workspace:*",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-fastify": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@supabase/supabase-js": "^2.50.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@jaago/config-typescript": "workspace:*",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.3",
    "@types/node": "^22.15.32",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  }
}
