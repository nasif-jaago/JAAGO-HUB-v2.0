{
  "extends": "../../packages/config/typescript/nestjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/core/*": ["./src/core/*"],
      "@/modules/*": ["./src/modules/*"],
      "@jaago/database/schema": ["./src/core/database/schema/index.ts"],
      "@jaago/*": ["./src/core/*"]
    },
    "outDir": "dist"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.integration.ts"]
}
