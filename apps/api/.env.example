# ============================================================
# apps/api — JAAGO ERP Backend — EXAMPLE
# Copy this to .env and fill in your values.
# NEVER commit .env — only commit .env.example
# ============================================================

NODE_ENV=development
PORT=3001
API_VERSION=v1

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# Get connection string from: Supabase → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 64
ENCRYPTION_KEK=REPLACE_WITH_GENERATED_KEY

# Supabase JWT JWKS endpoint
JWT_PUBLIC_KEY_URL=https://YOUR_PROJECT_ID.supabase.co/auth/v1/keys

CORS_ORIGIN=http://localhost:3000

RATE_LIMIT_ANON=20
RATE_LIMIT_AUTH=300
RATE_LIMIT_AUTH_ENDPOINTS=10

# Email (leave empty to use console transport in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@jaago-hub.org

GOOGLE_OAUTH_ENABLED=true
GOOGLE_ALLOWED_DOMAIN=jaago.com.bd

OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=debug
